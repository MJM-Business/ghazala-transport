# Vite development/preview proxy only. Copy to .env.local if the Python port differs.
# Use an origin without a path. This value is not exposed through a VITE_ variable.
GHAZALA_BACKEND_URL="http://127.0.0.1:8010"

# Python reads these from the process environment; it does not load .env files.
# Optional SMS integration. Empty credentials leave SMS in demo delivery mode.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional public origin used in tracking links sent by the Python server.
PUBLIC_BASE_URL=""
